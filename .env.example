APP_TIME_ZONE=Asia/Kolkata
SMARTBUS_DB_PATH=./data/smartbus.sqlite
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Required for a production first admin account. Use a long random password.
SMARTBUS_ADMIN_EMAIL=
SMARTBUS_ADMIN_PASSWORD=

# Optional map provider settings. Default tiles are OpenStreetMap.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>
